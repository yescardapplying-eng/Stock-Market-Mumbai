# ==============================================================
# STOCK MARKET MUMBAI — PRODUCTION & VERCEL CONFIGURATION
# ==============================================================

# Primary Site URL (Vercel preview URL or https://stockmarketmumbai.in)
NEXT_PUBLIC_SITE_URL=https://stockmarketmumbai.in

# Admin Portal URL for live cross-domain lead sync (Vercel Admin URL or https://admin.stockmarketmumbai.in)
ADMIN_PORTAL_URL=https://admin.stockmarketmumbai.in
ADMIN_INGEST_SECRET=SMM_Admin_Ingest_2026_Secret_Key

# Node.js Server Environment (Hostinger)
PORT=3000
NODE_ENV=production

# --------------------------------------------------------------
# MYSQL DATABASE CONFIGURATION (Hostinger MySQL or TiDB Cloud)
# --------------------------------------------------------------
# Leave DB_HOST empty during initial Vercel sample testing if using Admin webhook sync,
# OR configure shared MySQL / TiDB Cloud credentials for persistent database storage.
DB_HOST=
DB_PORT=3306
DB_NAME=stock_market_mumbai
DB_USER=root
DB_PASS=
DB_SSL=false

